<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TUnit test projects are self-hosting executables on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Snapshot testing for rendered output such as the Markdown pipelines. -->
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlogEngine.Shared\BlogEngine.Shared.csproj" />
    <!-- For query rules such as VisibleToPublic, tested with LINQ to Objects and SQL translation. -->
    <ProjectReference Include="..\..\src\BlogEngine.Data\BlogEngine.Data.csproj" />
  </ItemGroup>

</Project>
