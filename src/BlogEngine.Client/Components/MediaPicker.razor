@* Insert-image dialog for the Markdown editor (design 9.5, T2.11): pick from the library (with a "Recently used"
   row) or upload, then choose alt text, caption, size and alignment. *@
@if (_open)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onkeydown="OnKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="@_titleId">@(_pickTitle ?? (_selected is null ? "Insert image" : "Image details"))</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
                </div>

                @if (_selected is null)
                {
                    <div class="modal-body media-picker-body">
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button type="button" role="tab" class="nav-link @(_tab == PickerTab.Library ? "active" : null)"
                                        aria-selected="@AriaBool(_tab == PickerTab.Library)" @onclick="() => _tab = PickerTab.Library">
                                    <span class="bi bi-images me-1" aria-hidden="true"></span> Library
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button type="button" role="tab" class="nav-link @(_tab == PickerTab.Upload ? "active" : null)"
                                        aria-selected="@AriaBool(_tab == PickerTab.Upload)" @onclick="() => _tab = PickerTab.Upload">
                                    <span class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></span> Upload
                                </button>
                            </li>
                        </ul>

                        @if (_tab == PickerTab.Upload)
                        {
                            <MediaUploadZone Compact="true" OnUploaded="OnUploaded" OnBatchCompleted="OnUploadBatchCompleted" />
                        }
                        else
                        {
                            @if (_recent.Count > 0 && string.IsNullOrWhiteSpace(_appliedSearch))
                            {
                                <h3 class="h6 text-body-secondary">Recently used</h3>
                                <div class="media-picker-recent d-flex gap-2 mb-3 pb-1">
                                    @foreach (var item in _recent)
                                    {
                                        <button type="button" class="media-picker-thumb recent" title="@item.FileName" @onclick="() => Select(item)" @key="item.Id">
                                            <img src="@item.Url" alt="@(string.IsNullOrEmpty(item.AltText) ? item.FileName : item.AltText)" loading="lazy" decoding="async" />
                                        </button>
                                    }
                                </div>
                            }

                            <form class="row g-2 mb-3" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                                <div class="col">
                                    <div class="form-floating">
                                        <input type="search" id="media-picker-search" class="form-control" placeholder="Search" @bind="_search" />
                                        <label for="media-picker-search">Search the library</label>
                                    </div>
                                </div>
                                <div class="col-auto d-flex">
                                    <button type="submit" class="btn btn-outline-primary">
                                        <span class="bi bi-search" aria-hidden="true"></span><span class="visually-hidden">Search</span>
                                    </button>
                                </div>
                            </form>

                            @if (_loadError is not null)
                            {
                                <div class="alert alert-danger" role="alert">@_loadError</div>
                            }
                            else if (_items.Count == 0 && !_loading)
                            {
                                <p class="text-body-secondary text-center py-4 mb-0">
                                    @(string.IsNullOrWhiteSpace(_appliedSearch) ? "The library is empty. Upload an image to insert it." : "No images match.")
                                </p>
                            }
                            else
                            {
                                <div class="media-picker-grid">
                                    @foreach (var item in _items)
                                    {
                                        <button type="button" class="media-picker-thumb" title="@item.FileName" @onclick="() => Select(item)" @key="item.Id">
                                            <img src="@item.Url" alt="@(string.IsNullOrEmpty(item.AltText) ? item.FileName : item.AltText)" loading="lazy" decoding="async" />
                                            <span class="media-picker-thumb-name">@item.FileName</span>
                                        </button>
                                    }
                                </div>
                            }

                            @if (_loading)
                            {
                                <p class="text-body-secondary text-center mt-3 mb-0"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading…</p>
                            }
                            else if (_hasMore)
                            {
                                <div class="text-center mt-3">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadMoreAsync">Load more</button>
                                </div>
                            }
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                    </div>
                }
                else
                {
                    <EditForm Model="_details" OnValidSubmit="InsertAsync">
                        <FluentValidator Validator="DetailsValidator" />
                        <div class="modal-body">
                            <div class="row g-4">
                                <div class="col-12 col-md-5">
                                    <img src="@_selected.Url" alt="" class="media-picker-selected" />
                                    <p class="small text-body-secondary mt-2 mb-0">@_selected.FileName · @_selected.Width × @_selected.Height</p>
                                </div>
                                <div class="col-12 col-md-7">
                                    <div class="form-floating mb-1">
                                        <InputText id="media-picker-alt" class="form-control" placeholder="Alt text" maxlength="@FieldLengths.AltText"
                                                   disabled="@_details.IsDecorative" @bind-Value="_details.AltText" />
                                        <label for="media-picker-alt">Alt text</label>
                                    </div>
                                    <ValidationMessage For="() => _details.AltText" class="text-danger small" />
                                    @if (string.IsNullOrWhiteSpace(_selected.AltText) && !_details.IsDecorative)
                                    {
                                        <div class="form-text">This image has no alt text yet. Describe what it shows for people who can't see it.</div>
                                        <div class="form-check mt-1">
                                            <InputCheckbox id="media-picker-save-alt" class="form-check-input" @bind-Value="_details.SaveAltTextToLibrary" />
                                            <label class="form-check-label small" for="media-picker-save-alt">Also save it as the library's alt text</label>
                                        </div>
                                    }
                                    <div class="form-check mt-1 mb-3">
                                        <InputCheckbox id="media-picker-decorative" class="form-check-input" @bind-Value="_details.IsDecorative" />
                                        <label class="form-check-label small" for="media-picker-decorative">Decorative image (no alt text)</label>
                                    </div>

                                    <div class="form-floating mb-1">
                                        <InputText id="media-picker-caption" class="form-control" placeholder="Caption" maxlength="@FieldLengths.Caption"
                                                   @bind-Value="_details.Caption" />
                                        <label for="media-picker-caption">Caption (optional)</label>
                                    </div>
                                    <ValidationMessage For="() => _details.Caption" class="text-danger small" />

                                    <fieldset class="mt-3">
                                        <legend class="form-label small mb-1">Size</legend>
                                        <div class="btn-group btn-group-sm" role="group">
                                            @foreach (var size in Sizes)
                                            {
                                                var inputId = $"media-picker-size-{size.Value}";
                                                <input type="radio" class="btn-check" name="media-picker-size" id="@inputId" autocomplete="off"
                                                       checked="@(_details.Size == size.Value)" @onchange="() => _details.Size = size.Value" />
                                                <label class="btn btn-outline-secondary" for="@inputId">@size.Label</label>
                                            }
                                        </div>
                                    </fieldset>

                                    <fieldset class="mt-3">
                                        <legend class="form-label small mb-1">Alignment</legend>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <input type="radio" class="btn-check" name="media-picker-align" id="media-picker-align-none" autocomplete="off"
                                                   checked="@(!_details.Center)" @onchange="() => _details.Center = false" />
                                            <label class="btn btn-outline-secondary" for="media-picker-align-none">None</label>
                                            <input type="radio" class="btn-check" name="media-picker-align" id="media-picker-align-center" autocomplete="off"
                                                   checked="@_details.Center" @onchange="() => _details.Center = true" />
                                            <label class="btn btn-outline-secondary" for="media-picker-align-center">Center</label>
                                        </div>
                                    </fieldset>

                                    <div class="small text-body-secondary mt-3 mb-1">Markdown</div>
                                    <code class="d-block small text-break">@Markdown</code>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary me-auto" @onclick="Back">
                                <span class="bi bi-arrow-left me-1" aria-hidden="true"></span> Back
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@_inserting">
                                <span class="bi bi-image me-1" aria-hidden="true"></span> Insert
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
