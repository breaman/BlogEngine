@* Crop, rotate and flip on top of Cropper.js v2 (design 9.2, T2.9). cropper.js owns the two host elements;
   Blazor never renders into them. *@
<div class="image-cropper">
    <div class="btn-toolbar gap-2 mb-2" role="toolbar" aria-label="Image tools">
        <div class="btn-group btn-group-sm" role="group" aria-label="Rotate and flip">
            <button type="button" class="btn btn-outline-secondary" title="Rotate left" aria-label="Rotate 90° left"
                    disabled="@(!_ready)" @onclick="() => RotateAsync(-90)">
                <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
            </button>
            <button type="button" class="btn btn-outline-secondary" title="Rotate right" aria-label="Rotate 90° right"
                    disabled="@(!_ready)" @onclick="() => RotateAsync(90)">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span>
            </button>
            <button type="button" class="btn btn-outline-secondary" title="Flip horizontally" aria-label="Flip horizontally"
                    aria-pressed="@AriaBool(_state.FlipHorizontal)" disabled="@(!_ready)" @onclick="() => FlipAsync(horizontal: true)">
                <span class="bi bi-symmetry-vertical" aria-hidden="true"></span>
            </button>
            <button type="button" class="btn btn-outline-secondary" title="Flip vertically" aria-label="Flip vertically"
                    aria-pressed="@AriaBool(_state.FlipVertical)" disabled="@(!_ready)" @onclick="() => FlipAsync(horizontal: false)">
                <span class="bi bi-symmetry-horizontal" aria-hidden="true"></span>
            </button>
        </div>
        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Aspect ratio">
            @foreach (var preset in AspectPresets)
            {
                <button type="button" class="btn btn-outline-secondary @(_aspect == preset.Name ? "active" : null)"
                        aria-pressed="@AriaBool(_aspect == preset.Name)" disabled="@(!_ready)" @onclick="() => SetAspectAsync(preset)">
                    @preset.Name
                </button>
            }
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Start again from the original" disabled="@(!_ready)" @onclick="ResetAsync">
            <span class="bi bi-arrow-repeat me-1" aria-hidden="true"></span> Reset
        </button>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-9">
            <div class="image-cropper-stage">
                <div class="image-cropper-host" @ref="_host"></div>
                @if (_loadError is not null)
                {
                    <div class="image-cropper-overlay text-danger"><span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>@_loadError</div>
                }
                else if (!_ready)
                {
                    <div class="image-cropper-overlay text-body-secondary">
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading the original…
                    </div>
                }
            </div>
        </div>
        <div class="col-12 col-lg-3">
            <div class="small text-body-secondary mb-1">Preview</div>
            <div class="image-cropper-preview mb-2" @ref="_previewHost"></div>
            @if (_state.Crop is { } crop)
            {
                <p class="small mb-0" aria-live="polite">
                    Selection: <strong>@crop.Width × @crop.Height</strong> px
                    <span class="text-body-secondary">at @crop.X, @crop.Y</span>
                </p>
            }
        </div>
    </div>
</div>
