<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <!-- Connects FluentValidation validators to the Identity and setup forms through <FluentValidator />. -->
    <PackageReference Include="Blazilla" />
    <!-- AddValidatorsFromAssemblyContaining, for the validators nested in server components. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Sanitizes rendered comment and post HTML (design 5.3, 12.2). -->
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <!-- Two-level cache for settings and public queries, with tag-based eviction (design 11). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <!-- Decodes, auto-orients, strips metadata from, edits and re-encodes uploaded images (design 5.3, 9.1). -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- RSS 2.0 and Atom feeds (design 16). -->
    <PackageReference Include="System.ServiceModel.Syndication" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aspire\BlogEngine.ServiceDefaults\BlogEngine.ServiceDefaults.csproj" />
    <ProjectReference Include="..\BlogEngine.Client\BlogEngine.Client.csproj" />
    <ProjectReference Include="..\BlogEngine.Data\BlogEngine.Data.csproj" />
  </ItemGroup>

  <Target Name="CopyBootstrapJs" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\js" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\node_modules\bootstrap\dist\js\bootstrap.bundle.min.js"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\js"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Public-site JavaScript (design 10.3, T1.23, T4.14): scripts/public.js (the tiny loader on every page),
    scripts/code-blocks.js (highlight.js and copy buttons, loaded only for posts with code) and scripts/theme.js
    (the light/dark theme, applied from <head>) are built by esbuild into wwwroot/js. The "admin" bundles are built by BlogEngine.Client. Incremental, and skipped in
    Visual Studio design-time builds, which must not start external processes. The output is not committed.
  -->
  <ItemGroup>
    <PublicScriptSource Include="scripts\**\*.js;scripts\build-js.mjs;package-lock.json;..\BlogEngine.Client\scripts\highlighter.js" />
  </ItemGroup>

  <Target Name="BuildPublicScripts"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(PublicScriptSource)"
          Outputs="wwwroot\js\public.js;wwwroot\js\code-blocks.js;wwwroot\js\theme.js">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\node_modules\esbuild')"
           Text="esbuild was not found. Run 'npm install' in $(MSBuildProjectDirectory)." />
    <Exec Command="node ./scripts/build-js.mjs public" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- The wwwroot glob is evaluated before the bundles exist on a clean build, so add them to Content here
       for the static web assets pipeline to serve (and fingerprint) them. -->
  <Target Name="IncludePublicScripts" AfterTargets="BuildPublicScripts" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PublicScriptOutput Include="wwwroot\js\public.*;wwwroot\js\code-blocks.*;wwwroot\js\theme.*" />
      <Content Remove="@(_PublicScriptOutput)" />
      <Content Include="@(_PublicScriptOutput)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!-- Self-hosted Bootstrap Icons font files, referenced from site.css as ../fonts/ (see styles/site.scss). -->
  <Target Name="CopyBootstrapIconFonts" BeforeTargets="Build">
    <ItemGroup>
      <BootstrapIconFont Include="$(MSBuildProjectDirectory)\node_modules\bootstrap-icons\font\fonts\*.woff*" />
    </ItemGroup>
    <Error Condition="'@(BootstrapIconFont)' == ''" Text="Bootstrap Icons fonts were not found. Run 'npm install' in $(MSBuildProjectDirectory)." />
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\fonts" />
    <Copy SourceFiles="@(BootstrapIconFont)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\fonts"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
