<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <!-- Connects FluentValidation validators to the Identity and setup forms through <FluentValidator />. -->
    <PackageReference Include="Blazilla" />
    <!-- AddValidatorsFromAssemblyContaining, for the validators nested in server components. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Sanitizes rendered comment and post HTML (design 5.3, 12.2). -->
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <!-- Two-level cache for settings and public queries, with tag-based eviction (design 11). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <!-- RSS 2.0 and Atom feeds (design 16). -->
    <PackageReference Include="System.ServiceModel.Syndication" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aspire\BlogEngine.ServiceDefaults\BlogEngine.ServiceDefaults.csproj" />
    <ProjectReference Include="..\BlogEngine.Client\BlogEngine.Client.csproj" />
    <ProjectReference Include="..\BlogEngine.Data\BlogEngine.Data.csproj" />
  </ItemGroup>

  <Target Name="CopyBootstrapJs" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\js" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\node_modules\bootstrap\dist\js\bootstrap.bundle.min.js"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\js"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Self-hosted Bootstrap Icons font files, referenced from site.css as ../fonts/ (see styles/site.scss). -->
  <Target Name="CopyBootstrapIconFonts" BeforeTargets="Build">
    <ItemGroup>
      <BootstrapIconFont Include="$(MSBuildProjectDirectory)\node_modules\bootstrap-icons\font\fonts\*.woff*" />
    </ItemGroup>
    <Error Condition="'@(BootstrapIconFont)' == ''" Text="Bootstrap Icons fonts were not found. Run 'npm install' in $(MSBuildProjectDirectory)." />
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\fonts" />
    <Copy SourceFiles="@(BootstrapIconFont)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\fonts"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
