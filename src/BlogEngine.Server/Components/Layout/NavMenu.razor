<header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
        <div class="container">
            <a class="navbar-brand d-flex flex-column lh-sm py-1" href="/">
                <span class="fw-semibold">@_siteTitle</span>
                @if (!string.IsNullOrWhiteSpace(_tagline))
                {
                    <small class="site-tagline text-body-secondary fw-normal">@_tagline</small>
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                            <span class="bi bi-house-door" aria-hidden="true"></span> Home
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@PostPaths.Index" Match="NavLinkMatch.Prefix">
                            <span class="bi bi-journal-text" aria-hidden="true"></span> Posts
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@TagPaths.Index" Match="NavLinkMatch.Prefix">
                            <span class="bi bi-tags" aria-hidden="true"></span> Tags
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@SitePaths.Archive" Match="NavLinkMatch.All">
                            <span class="bi bi-archive" aria-hidden="true"></span> Archive
                        </NavLink>
                    </li>
                    @* Standalone pages marked "show in navigation" (design 6.7, A17), in their chosen order. *@
                    @foreach (var navPage in _navPages)
                    {
                        <li class="nav-item" @key="navPage.Id">
                            <NavLink class="nav-link" href="@navPage.Path" Match="NavLinkMatch.All">@navPage.Title</NavLink>
                        </li>
                    }
                </ul>

                @* A plain GET form, so search works without JavaScript (design 15). *@
                <form class="site-search my-2 my-lg-0 me-lg-3" role="search" action="@SitePaths.Search" method="get">
                    <div class="form-floating">
                        <input type="search" class="form-control" id="site-search" name="q" placeholder="Search posts" autocomplete="off" />
                        <label for="site-search"><span class="bi bi-search" aria-hidden="true"></span> Search</label>
                    </div>
                </form>

                <ul class="navbar-nav">
                    <BlogEngine.Client.Components.ThemeToggle />
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="bi bi-person-circle" aria-hidden="true"></span> Welcome, @FirstName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <AuthorizeView Policy="@AuthorizationPolicies.AdminOnly" Context="adminContext">
                                        <li>
                                            <NavLink class="dropdown-item" href="/admin">
                                                <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
                                            </NavLink>
                                        </li>
                                    </AuthorizeView>
                                    <li>
                                        <NavLink class="dropdown-item" href="/Account/Manage">
                                            <span class="bi bi-gear" aria-hidden="true"></span> Manage Account
                                        </NavLink>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form action="/Account/Logout" method="post" class="m-0">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="returnUrl" value="" />
                                            <button type="submit" class="dropdown-item">
                                                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            @if (_registrationAllowed)
                            {
                                <li class="nav-item">
                                    <NavLink class="nav-link" href="/Account/Register">
                                        <span class="bi bi-person-plus" aria-hidden="true"></span> Register
                                    </NavLink>
                                </li>
                            }
                            <li class="nav-item">
                                <NavLink class="nav-link" href="/Account/Login">
                                    <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Log in
                                </NavLink>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
            </div>
        </div>
    </nav>
</header>
