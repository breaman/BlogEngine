@page "/posts/{Year:int}/{Month:int}/{Day:int}/{Slug}"

@if (_post is not null)
{
    var post = _post.Post;

    <SeoHead Title="@(_post.MetaTitle ?? post.Title)" Description="@(_post.MetaDescription ?? post.Summary)" CanonicalPath="@post.Path"
             Image="_post.SocialImage" Article="SeoArticle.From(post)" />

    <article class="post mx-auto">
        <header class="mb-4">
            <h1 class="post-title mb-2">@post.Title</h1>
            <PostMeta Post="post" DateFormat="@_dateFormat" LinkDate="true" UpdatedDate="_updatedDate" />
        </header>

        @if (_post.Cover is { } cover)
        {
            @* The cover is usually the largest element above the fold, so it loads first rather than lazily (A15). *@
            <figure class="post-cover mb-4">
                <img src="@cover.Url" alt="@cover.AltText" width="@cover.Width" height="@cover.Height"
                     class="img-fluid rounded" fetchpriority="high" decoding="async" />
            </figure>
        }

        <TableOfContents Entries="_post.TableOfContents" PagePath="@post.Path" />

        @* data-code-blocks tells js/public.js to load highlighting and copy buttons (design 10.3). *@
        <div class="post-content" data-code-blocks="@(_post.HasCodeBlocks ? "true" : null)">
            @((MarkupString)_post.Html)
        </div>

        <footer class="post-footer mt-5 pt-3 border-top">
            @if (post.Tags.Count > 0)
            {
                <p class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="bi bi-tags text-body-secondary" aria-hidden="true"></span>
                    <span class="visually-hidden">Tags:</span>
                    @foreach (var tag in post.Tags)
                    {
                        <TagBadge Name="@tag.Name" Slug="@tag.Slug" />
                    }
                </p>
            }

            <p class="share-links d-flex flex-wrap align-items-center gap-3 small mb-0">
                <span class="text-body-secondary">Share:</span>
                @foreach (var link in _shareLinks)
                {
                    <a class="link-secondary" href="@link.Href" target="_blank" rel="noopener noreferrer">
                        <span class="bi @link.Icon" aria-hidden="true"></span> @link.Network
                    </a>
                }
            </p>
        </footer>

        <PostNavigation Neighbors="_neighbors" Related="_related" DateFormat="@_dateFormat" />
    </article>

    @if (_comments.Count > 0 || _commentsOpen || _commentsClosed)
    {
        @* Approved comments, then the form or a closed notice (design 14.2, 8.5). Not rendered at all when comments are
           turned off site-wide and the post has none. *@
        <section id="comments" class="post mx-auto mt-5" aria-labelledby="comments-heading">
            <h2 id="comments-heading" class="h4 mb-3">
                @(_comments.Count switch { 0 => "Comments", 1 => "1 comment", var n => $"{n} comments" })
            </h2>

            @if (_comments.Count > 0)
            {
                <CommentList Comments="_comments" ShowAvatars="_showAvatars" Now="_now" ReplyPath="@(_commentsOpen ? post.Path : null)" />
            }
            else if (_commentsOpen)
            {
                <p class="text-body-secondary">No comments yet.</p>
            }

            @if (_commentsOpen)
            {
                <CommentForm PostId="post.Id" PostPath="@post.Path" Comments="_comments" ReplyTo="ReplyTo" />
            }
            else if (_commentsClosed)
            {
                <p class="text-body-secondary mt-3 mb-0"><span class="bi bi-lock" aria-hidden="true"></span> Comments are closed.</p>
            }
        </section>
    }
}
