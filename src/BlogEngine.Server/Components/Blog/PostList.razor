@* The list shared by /posts, the date archives and tag pages (design 7.1, 14.1). *@
@if (Page.Posts.Count == 0)
{
    <p class="text-body-secondary">@EmptyText</p>
}
else
{
    <div class="post-list">
        @foreach (var post in Page.Posts)
        {
            <PostCard Post="post" DateFormat="@DateFormat" />
        }
    </div>
    <Pager Page="Page.Page" TotalPages="Page.TotalPages" BasePath="@BasePath" />
}
