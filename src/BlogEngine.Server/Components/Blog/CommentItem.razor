@* One comment: avatar, author (linked to their website with rel="nofollow ugc noopener"), relative date and body.
   Emails are never rendered; with avatars off, the colored initial avoids any third-party request (design 8.1, 12.3). *@
<article class="comment d-flex gap-3 py-3" id="comment-@Comment.Id">
    @if (ShowAvatars)
    {
        <img class="comment-avatar rounded-circle flex-shrink-0" src="@CommentAvatar.GravatarUrl(Comment.AvatarHash)" alt=""
             width="40" height="40" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
    }
    else
    {
        <span class="comment-avatar rounded-circle flex-shrink-0 d-inline-flex align-items-center justify-content-center fw-semibold @CommentAvatar.ColorClass(Comment.AvatarHash)"
              aria-hidden="true">@CommentAvatar.Initial(Comment.AuthorName)</span>
    }
    <div class="comment-main flex-grow-1">
        <header class="d-flex flex-wrap align-items-baseline column-gap-2 mb-1">
            @if (Comment.AuthorUrl is { } url)
            {
                <a class="comment-author fw-semibold" href="@url" rel="@LinkRel">@Comment.AuthorName</a>
            }
            else
            {
                <span class="comment-author fw-semibold">@Comment.AuthorName</span>
            }
            @if (Comment.IsAuthorReply)
            {
                <span class="badge text-bg-primary">Author</span>
            }
            <a class="small link-secondary" href="#comment-@Comment.Id">
                <time datetime="@IsoDate" title="@FullDate">@RelativeTime.Format(Comment.CreatedOn, Now)</time>
            </a>
        </header>
        <div class="comment-body">@((MarkupString)Comment.BodyHtml)</div>
    </div>
</article>
