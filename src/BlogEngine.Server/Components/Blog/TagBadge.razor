@* A link to a tag page, styled as a small pill (design 14.1). *@
<a class="tag-badge badge rounded-pill bg-body-tertiary text-body border text-decoration-none fw-normal" href="@TagPaths.Tag(Slug)"><span>#@Name</span>@if (Count is { } count)
{
    <span class="ms-1 text-body-secondary">@count</span>
}</a>
